# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (Atlas ya local)
MONGO_URI=mongodb://127.0.0.1:27017/influencer_platform

# Frontend ka URL (CORS ke liye)
CLIENT_URL=http://localhost:3000

# Platform ka naam (abhi final nahi)
PLATFORM_NAME=Influence Platform

# JWT secrets: lambi random strings. Banane ke liye:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Email (password reset ka OTP, muahide ke sign codes) Resend se: resend.com -> API Keys.
# Khali ho to development mein email terminal pe print hoti hai.
RESEND_API_KEY=
# Bhejne wale ka naam aur email, Resend mein verified domain ka: Influence Platform <support@yourdomain.com>
# Khali ho to Resend ka test sender (onboarding@resend.dev), jo sirf aap ke Resend account ke email pe bhejta hai
MAIL_FROM=
